	"environment": "client",
	"entrypoints": {
		"client": [
			"com.coinrush.socle.client.SocleClient",
			"com.coinrush.panneau.client.PanneauClient",
			"com.coinrush.cinematique.client.CinematiqueClient",
			"com.coinrush.cinematique.client.LecteurClient",
			"com.coinrush.dialogue.client.DialogueClient",
			"com.coinrush.repere.client.RepereClient",
			"com.coinrush.chapeaux.client.ChapeauxClient",
			"com.coinrush.camera.client.CameraClient",
			"com.coinrush.carte.client.CarteClient",
			"com.coinrush.temporaire.client.ContenuTemporaireClient"
		]
	},
	"mixins": [
		"coinrush.mixins.json",
		"coinrush-carte.mixins.json"
